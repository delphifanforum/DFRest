<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-200000000103}</ProjectGuid>
    <MainSource>dclDFRest.dpk</MainSource>
    <ProjectVersion>18.8</ProjectVersion>
    <FrameworkType>None</FrameworkType>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Release</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <ProjectName Condition="'$(ProjectName)'==''">dclDFRest</ProjectName>
    <AppType>Package</AppType>
    <GenPackage>true</GenPackage>
    <GenDll>true</GenDll>
    <DesignOnlyPackage>true</DesignOnlyPackage>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)|$(Platform)'=='Release|Win32'">
    <DCC_DCPOutput>$(MSBuildProjectDirectory)\..\..\Lib\D103\$(Platform)\$(Config)</DCC_DCPOutput>
    <DCC_BplOutput>$(MSBuildProjectDirectory)\..\..\Lib\D103\$(Platform)\$(Config)</DCC_BplOutput>
    <DCC_ExeOutput>$(MSBuildProjectDirectory)\..\..\Lib\D103\$(Platform)\$(Config)</DCC_ExeOutput>
    <DCC_UnitSearchPath>$(MSBuildProjectDirectory)\..\..\Source;$(MSBuildProjectDirectory)\..\..\Source\Component;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_Description>DFRest 1.0.0 Type-safe REST Design-time - Delphifan</DCC_Description>
    <DCC_DcpSearchPath>$(MSBuildProjectDirectory)\..\..\Lib\D103\$(Platform)\$(Config);$(DCC_DcpSearchPath)</DCC_DcpSearchPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)|$(Platform)'=='Debug|Win32'">
    <DCC_DCPOutput>$(MSBuildProjectDirectory)\..\..\Lib\D103\$(Platform)\$(Config)</DCC_DCPOutput>
    <DCC_BplOutput>$(MSBuildProjectDirectory)\..\..\Lib\D103\$(Platform)\$(Config)</DCC_BplOutput>
    <DCC_ExeOutput>$(MSBuildProjectDirectory)\..\..\Lib\D103\$(Platform)\$(Config)</DCC_ExeOutput>
    <DCC_UnitSearchPath>$(MSBuildProjectDirectory)\..\..\Source;$(MSBuildProjectDirectory)\..\..\Source\Component;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_Description>DFRest 1.0.0 Type-safe REST Design-time - Delphifan</DCC_Description>
    <DCC_DcpSearchPath>$(MSBuildProjectDirectory)\..\..\Lib\D103\$(Platform)\$(Config);$(DCC_DcpSearchPath)</DCC_DcpSearchPath>
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="rtl.dcp" />
    <DCCReference Include="designide.dcp" />
    <DCCReference Include="DFRest.dcp" />
    <DCCReference Include="..\..\Source\Component\DFRest.Reg.pas" />
    <BuildConfiguration Include="Release">
      <Key>Cfg_2</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
    <BuildConfiguration Include="Base">
      <Key>Base</Key>
    </BuildConfiguration>
    <BuildConfiguration Include="Debug">
      <Key>Cfg_1</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
  </ItemGroup>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')" />
</Project>
