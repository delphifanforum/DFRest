package DFRest;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'DFRest 1.0.0 Type-safe REST Runtime - Delphifan'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  xmlrtl,
  dbrtl,
  RESTComponents;

contains
  DFRest.Version in '..\..\Source\DFRest.Version.pas',
  DFRest.Types in '..\..\Source\DFRest.Types.pas',
  DFRest.Attributes in '..\..\Source\DFRest.Attributes.pas',
  DFRest.Exceptions in '..\..\Source\DFRest.Exceptions.pas',
  DFRest.Settings in '..\..\Source\DFRest.Settings.pas',
  DFRest.Response in '..\..\Source\DFRest.Response.pas',
  DFRest.Http in '..\..\Source\DFRest.Http.pas',
  DFRest.Json in '..\..\Source\DFRest.Json.pas',
  DFRest.Proxy in '..\..\Source\DFRest.Proxy.pas',
  DFRest.Service in '..\..\Source\DFRest.Service.pas',
  DFRest.Component in '..\..\Source\Component\DFRest.Component.pas';

end.
