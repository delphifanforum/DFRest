<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{E5F6A7B8-C9D0-1234-DF01-AEE57DE00001}</ProjectGuid>
    <MainSource>DFRestDemo.dpr</MainSource>
    <ProjectVersion>18.8</ProjectVersion>
    <FrameworkType>VCL</FrameworkType>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <ProjectName Condition="'$(ProjectName)'==''">DFRestDemo</ProjectName>
    <AppType>Application</AppType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)|$(Platform)'=='Debug|Win32'">
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
    <DCC_UnitSearchPath>$(MSBuildProjectDirectory)\..\Source;$(MSBuildProjectDirectory)\..\Source\Component;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;Vcl.Shell;$(DCC_Namespace)</DCC_Namespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)|$(Platform)'=='Release|Win32'">
    <DCC_UnitSearchPath>$(MSBuildProjectDirectory)\..\Source;$(MSBuildProjectDirectory)\..\Source\Component;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;Vcl.Shell;$(DCC_Namespace)</DCC_Namespace>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="Demo.Main.pas">
      <Form>FormMain</Form>
    </DCCReference>
    <DCCReference Include="..\Source\DFRest.Version.pas" />
    <DCCReference Include="..\Source\DFRest.Types.pas" />
    <DCCReference Include="..\Source\DFRest.Attributes.pas" />
    <DCCReference Include="..\Source\DFRest.Exceptions.pas" />
    <DCCReference Include="..\Source\DFRest.Settings.pas" />
    <DCCReference Include="..\Source\DFRest.Response.pas" />
    <DCCReference Include="..\Source\DFRest.Http.pas" />
    <DCCReference Include="..\Source\DFRest.Json.pas" />
    <DCCReference Include="..\Source\DFRest.Proxy.pas" />
    <DCCReference Include="..\Source\DFRest.Service.pas" />
    <DCCReference Include="..\Source\Component\DFRest.Component.pas" />
    <BuildConfiguration Include="Debug">
      <Key>Cfg_1</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
    <BuildConfiguration Include="Base">
      <Key>Base</Key>
    </BuildConfiguration>
    <BuildConfiguration Include="Release">
      <Key>Cfg_2</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
  </ItemGroup>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')" />
</Project>
